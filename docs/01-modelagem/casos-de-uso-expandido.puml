@startuml
left to right direction
actor Professor
rectangle "EduNotas" {
 usecase "Cadastrar aluno" as Cadastrar
 usecase "Validar dados\nbásicos" as ValidarCadastro
 usecase "Gravar aluno\n(no PostgreSQL)" as PersistirAluno
 usecase "Consultar notas\ndo aluno" as Consultar
 usecase "Editar notas\n(0 a 10)" as Editar
 usecase "Validar intervalo\ndas notas" as ValidarNotas
 usecase "Gravar notas\n(no PostgreSQL)" as PersistirNotas
 usecase "Calcular média\naritmética" as Media
}
Professor --> Cadastrar
Professor --> Consultar
Professor --> Editar
Cadastrar .> ValidarCadastro : <<include>>
Cadastrar .> PersistirAluno : <<include>>
Editar .> ValidarNotas : <<include>>
Editar .> PersistirNotas : <<include>>
Consultar .> Media : <<include>>
Editar .> Media : <<include>>
note bottom of Media
  Média = (nota 1 + nota 2) / 2
  O resultado é derivado e não persistido.
end note
@enduml
